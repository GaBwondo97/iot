# CityPulse AI — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to Git.

# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database Connection (Local / Development)
# Format: postgresql+asyncpg://user:password@host:5432/database
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/citypulse

# JWT / Auth Secret (Backend)
JWT_SECRET=your-secret-key-here

# MQTT Broker (IoT)
MQTT_BROKER_HOST=mqtt://localhost:1883
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=citypulse
MQTT_QOS=1

# AI Engine Configuration
RISK_CONFIG_PATH=risk_config.yaml

# Data Source API Keys (if needed)
OPEN_METEO_API_KEY=your-open-meteo-key-here
OPENAQ_API_KEY=your-openaq-key-here
EMQX_API_KEY=your-emqx-key-here

# Logging
LOG_LEVEL=INFO
