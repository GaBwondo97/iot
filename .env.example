# CityPulse AI — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to Git.

# === Phase 1: Required ===
APP_NAME=CityPulse AI
APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_API_URL=http://127.0.0.1:8000

# === Phase 2+: Reserved for Future Integration ===
# Database (Supabase PostgreSQL)
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-public-anon-key-here  # Frontend only
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here  # Backend only, never expose to frontend

# Database Connection (Local / Development)
# DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/citypulse

# JWT / Auth Secret (Backend)
# JWT_SECRET=your-secret-key-here

# MQTT Broker (IoT)
# MQTT_BROKER_HOST=mqtt://localhost:1883
# MQTT_BROKER_PORT=1883
# MQTT_TOPIC_PREFIX=citypulse
# MQTT_QOS=1

# Data Source API Keys (if needed)
# OPEN_METEO_API_KEY=your-open-meteo-key-here
# OPENAQ_API_KEY=your-openaq-key-here
# EMQX_API_KEY=your-emqx-key-here

# Logging
# LOG_LEVEL=INFO